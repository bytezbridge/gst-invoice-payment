# ==============================================================
# GST Invoice Generator — Payment Server Configuration
# Copy this file to `.env` and fill in YOUR keys.
# NEVER commit .env to git. Already in .gitignore.
# ==============================================================

# ---------- Server ----------
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://your-landing-page.com

# ---------- Razorpay ----------
# Get these from: https://dashboard.razorpay.com/app/keys
# TEST mode keys start with rzp_test_, LIVE with rzp_live_
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Webhook secret — set this when creating the webhook in Razorpay dashboard
# https://dashboard.razorpay.com/app/webhooks
# Use a long random string: openssl rand -hex 32
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_HEX_64_CHARS

# Plan IDs — create these in Razorpay dashboard FIRST, then paste the IDs here
# https://dashboard.razorpay.com/app/subscriptions/plans
RAZORPAY_PLAN_STARTER_MONTHLY=plan_REPLACE_ME
RAZORPAY_PLAN_PRO_MONTHLY=plan_REPLACE_ME

# ---------- Email (Resend) ----------
# Get key: https://resend.com/api-keys
# Free tier = 3000 emails/month — more than enough for launch
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM="GST Invoice Generator <noreply@your-landing-page.com>"
EMAIL_REPLY_TO=r.balaganapathi@gmail.com

# ---------- Pricing (in paise — 1 INR = 100 paise) ----------
PRICE_STARTER_MONTHLY=79900
PRICE_PRO_MONTHLY=249900
PRICE_LIFETIME=999900
PRICE_COMMERCIAL_LICENSE=499900
PRICE_WHITELABEL_LICENSE=1499900

# Foreign currency (paise of relevant minor unit)
PRICE_LIFETIME_USD_CENTS=11900

# ---------- License delivery ----------
# Where the buyer-deliverable zip lives (relative to server.js)
DELIVERABLE_ZIP_PATH=./deliverables/gst-invoice-generator-v1.0.0.zip

# How long a download link is valid (seconds)
DOWNLOAD_LINK_TTL=604800

# ---------- Database ----------
# SQLite — zero config, zero ops
DB_PATH=./data/payments.sqlite

# ---------- Security ----------
# Long random string used to sign download tokens
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# Comma-separated list of CORS origins
CORS_ORIGINS=https://your-landing-page.com,https://www.your-landing-page.com

# ---------- Optional: Slack/Discord notifications on every sale ----------
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
